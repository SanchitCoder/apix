# APIx environment template. Copy to .env and fill in locally.
# .env is git-ignored and must never be committed — see CLAUDE.md guardrails.

# ---------------------------------------------------------------- runtime ----
APIX_ENV=local                       # local | ci | staging | production
# Where config/*.yaml lives. Unset in a checkout (discovered by walking up);
# set to /app/config in the container images, where the walk-up would not find it.
APIX_CONFIG_DIR=
APIX_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
APIX_LOG_FORMAT=json                 # json | console (console is local-only)

# --------------------------------------------------------------- database ----
# Async DSN used by the API.
APIX_DATABASE_URL=postgresql+asyncpg://apix:CHANGEME@localhost:5432/apix
# Sync DSN used by Alembic and the collector.
APIX_DATABASE_SYNC_URL=postgresql+psycopg2://apix:CHANGEME@localhost:5432/apix
APIX_DB_POOL_SIZE=10
APIX_DB_POOL_MAX_OVERFLOW=5
APIX_DB_ECHO=false

# Consumed by the postgres container only.
POSTGRES_USER=apix
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=apix

# ------------------------------------------------------------------ redis ----
# Rate-limit token buckets and response caching.
APIX_REDIS_URL=redis://localhost:6379/0
APIX_REDIS_RATE_LIMIT_DB=1

# ------------------------------------------------------------- proxy pool ----
# Egress for collection. Credentials belong in a secret store, never in git.
APIX_PROXY_ENABLED=false
APIX_PROXY_POOL_URL=                 # e.g. http://gateway.example.net:8080
APIX_PROXY_USERNAME=
APIX_PROXY_PASSWORD=
APIX_PROXY_ROTATION=per_request      # per_request | per_session | sticky
APIX_PROXY_MAX_CONCURRENCY=4
APIX_PROXY_COUNTRY=IN                # collect from the market being measured

# ---------------------------------------------------------------- prefect ----
APIX_PREFECT_API_URL=http://localhost:4200/api
APIX_PREFECT_WORK_POOL=apix-default

# -------------------------------------------------------------------- api ----
APIX_SECRET_KEY=CHANGEME-generate-with-openssl-rand-hex-32
APIX_API_HOST=0.0.0.0
APIX_API_PORT=8000
APIX_API_CORS_ORIGINS=http://localhost:5173
APIX_API_PAGE_SIZE_DEFAULT=100
APIX_API_PAGE_SIZE_MAX=1000

# ------------------------------------------------------------- collection ----
# Identifies us to every source we touch. Must carry a contactable address.
APIX_USER_AGENT=APIx-StatisticalCollector/0.1 (+https://example.org/apix; contact@example.org)
APIX_RESPECT_ROBOTS=true             # never set false; the PolicyEngine refuses to start
APIX_DEFAULT_CRAWL_DELAY_S=2.0
